#!/bin/bash

# Torrent Streamer CLI - Terminal-friendly wrapper
# Usage: torrent-streamer [command] [options]

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
EXECUTABLE_NAME="torrent-streamer-$(uname -m)"
EXECUTABLE_PATH="$APP_DIR/dist-signed/$EXECUTABLE_NAME"
DATA_DIR="${DATA_DIR:-$HOME/.torrent-streamer}"
DOWNLOADS_DIR="$DATA_DIR/downloads"
STATE_DIR="$DATA_DIR/state"
PID_FILE="$DATA_DIR/torrent-streamer.pid"

# Colors for terminal output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Helper functions
print_header() {
  echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo -e "${CYAN}  🎬 Torrent Streamer${NC}"
  echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

print_success() {
  echo -e "${GREEN}✓ $1${NC}"
}

print_error() {
  echo -e "${RED}✗ $1${NC}"
}

print_info() {
  echo -e "${BLUE}ℹ $1${NC}"
}

print_warning() {
  echo -e "${YELLOW}⚠ $1${NC}"
}

show_help() {
  print_header
  echo ""
  echo "Commands:"
  echo "  start [options]     Start the Torrent Streamer"
  echo "  stop                Stop the running Torrent Streamer"
  echo "  status              Show the status of Torrent Streamer"
  echo "  logs                Show recent logs"
  echo "  open                Open the dashboard in your default browser"
  echo "  data                Show data directory location"
  echo "  install             Install as a global command"
  echo "  uninstall           Uninstall the global command"
  echo "  help                Show this help message"
  echo ""
  echo "Start options:"
  echo "  --port PORT         Set custom port (default: 8080)"
  echo "  --user USERNAME     Set username for authentication"
  echo "  --pass PASSWORD     Set password for authentication"
  echo "  --dir DIRECTORY     Set custom download directory"
  echo "  --background        Run in background"
  echo "  --no-browser        Don't open browser on start"
  echo ""
  echo "Examples:"
  echo "  torrent-streamer start"
  echo "  torrent-streamer start --port 3000 --background"
  echo "  torrent-streamer start --user admin --pass secure123"
  echo ""
}

ensure_directories() {
  mkdir -p "$DATA_DIR"
  mkdir -p "$DOWNLOADS_DIR"
  mkdir -p "$STATE_DIR"
}

check_executable() {
  if [ ! -f "$EXECUTABLE_PATH" ]; then
    print_error "Executable not found: $EXECUTABLE_PATH"
    print_info "Make sure the app is properly installed."
    exit 1
  fi
}

start_server() {
  local port="${PORT:-8080}"
  local username="${APP_USERNAME:-}"
  local password="${APP_PASSWORD:-}"
  local download_dir="${DOWNLOAD_DIR:-$DOWNLOADS_DIR}"
  local background=false
  local open_browser=true

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case $1 in
      --port)
        port="$2"
        shift 2
        ;;
      --user)
        username="$2"
        shift 2
        ;;
      --pass)
        password="$2"
        shift 2
        ;;
      --dir)
        download_dir="$2"
        shift 2
        ;;
      --background)
        background=true
        shift
        ;;
      --no-browser)
        open_browser=false
        shift
        ;;
      *)
        shift
        ;;
    esac
  done

  ensure_directories
  check_executable

  print_header
  echo ""
  print_info "Starting Torrent Streamer..."
  echo ""

  # Set environment variables
  export PORT="$port"
  export DOWNLOAD_DIR="$download_dir"
  export DATA_DIR="$DATA_DIR"
  export STATE_DIR="$STATE_DIR"
  [ -n "$username" ] && export APP_USERNAME="$username"
  [ -n "$password" ] && export APP_PASSWORD="$password"

  if [ "$background" = true ]; then
    # Run in background
    nohup "$EXECUTABLE_PATH" > "$DATA_DIR/torrent-streamer.log" 2>&1 &
    local pid=$!
    echo $pid > "$PID_FILE"
    sleep 2
    print_success "Started in background (PID: $pid)"
    echo ""
    print_info "Dashboard: ${CYAN}http://localhost:$port${NC}"
    print_info "Logs: ${CYAN}$DATA_DIR/torrent-streamer.log${NC}"
    echo ""
    if [ "$open_browser" = true ]; then
      sleep 1
      open "http://localhost:$port" 2>/dev/null || true
    fi
  else
    # Run in foreground
    echo ""
    print_info "Dashboard: ${CYAN}http://localhost:$port${NC}"
    print_info "Downloads: ${CYAN}$download_dir${NC}"
    echo ""
    print_info "Press ${YELLOW}Ctrl+C${NC} to stop the server"
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""

    # Run in foreground
    "$EXECUTABLE_PATH"
  fi
}

stop_server() {
  if [ ! -f "$PID_FILE" ]; then
    print_warning "No running Torrent Streamer found"
    return
  fi

  local pid=$(cat "$PID_FILE")
  if kill -0 "$pid" 2>/dev/null; then
    print_info "Stopping Torrent Streamer (PID: $pid)..."
    kill "$pid"
    rm -f "$PID_FILE"
    sleep 1
    print_success "Stopped"
  else
    print_warning "Process not running (removing stale PID file)"
    rm -f "$PID_FILE"
  fi
}

show_status() {
  print_header
  echo ""

  if [ -f "$PID_FILE" ]; then
    local pid=$(cat "$PID_FILE")
    if kill -0 "$pid" 2>/dev/null; then
      print_success "Running (PID: $pid)"
      echo ""
      print_info "Dashboard: ${CYAN}http://localhost:8080${NC}"
      print_info "Data directory: ${CYAN}$DATA_DIR${NC}"
      echo ""
      return
    fi
  fi

  print_warning "Not running"
  echo ""
}

show_logs() {
  if [ ! -f "$DATA_DIR/torrent-streamer.log" ]; then
    print_warning "No logs found yet"
    return
  fi

  print_header
  echo ""
  tail -50 "$DATA_DIR/torrent-streamer.log"
}

show_data_dir() {
  print_header
  echo ""
  print_info "Data directory: ${CYAN}$DATA_DIR${NC}"
  echo ""
  print_info "Contents:"
  if [ -d "$DATA_DIR" ]; then
    du -sh "$DATA_DIR"/* 2>/dev/null || print_warning "Directory is empty"
  else
    print_warning "Directory does not exist yet"
  fi
  echo ""
}

install_global() {
  print_header
  echo ""
  print_info "Installing as global command..."
  echo ""

  local bin_dir="/usr/local/bin"
  local link_path="$bin_dir/torrent-streamer"

  if [ ! -w "$bin_dir" ]; then
    print_error "Cannot write to $bin_dir (permission denied)"
    print_info "Try: sudo torrent-streamer install"
    exit 1
  fi

  if [ -L "$link_path" ] || [ -f "$link_path" ]; then
    rm -f "$link_path"
  fi

  ln -s "$SCRIPT_DIR/torrent-streamer" "$link_path"
  chmod +x "$SCRIPT_DIR/torrent-streamer"

  print_success "Installed to $link_path"
  echo ""
  print_info "You can now run ${CYAN}torrent-streamer${NC} from any terminal"
  echo ""
}

uninstall_global() {
  print_header
  echo ""
  print_info "Uninstalling global command..."
  echo ""

  local bin_dir="/usr/local/bin"
  local link_path="$bin_dir/torrent-streamer"

  if [ -L "$link_path" ] || [ -f "$link_path" ]; then
    rm -f "$link_path"
    print_success "Uninstalled"
  else
    print_warning "Global command not found"
  fi
  echo ""
}

# Main command dispatcher
case "${1:-start}" in
  start)
    shift
    start_server "$@"
    ;;
  stop)
    stop_server
    ;;
  status)
    show_status
    ;;
  logs)
    show_logs
    ;;
  open)
    open "http://localhost:8080" 2>/dev/null || print_error "Could not open browser"
    ;;
  data)
    show_data_dir
    ;;
  install)
    install_global
    ;;
  uninstall)
    uninstall_global
    ;;
  help|--help|-h)
    show_help
    ;;
  *)
    print_error "Unknown command: $1"
    echo ""
    show_help
    exit 1
    ;;
esac
